{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "tests/toolchain.test.ts", "tests/statePolicy.test.ts", "tests/evidenceStore.test.ts", "tests/evidenceRedact.test.ts", "tests/runtimeContainment.test.ts", "tests/mutationLock.test.ts", "tests/verifier.test.ts", "tests/initStatus.test.ts", "tests/t0Fixture.test.ts", "tests/runTask.test.ts", "tests/verify.test.ts", "tests/negativePaths.test.ts", "tests/t10Audit.test.ts", "tests/taskContract.test.ts", "tests/projectDetection.test.ts", "tests/verificationAdapter.test.ts", "tests/boundedReplacement.test.ts", "tests/projectScope.test.ts", "tests/projectScopeGitStatus.test.ts", "tests/helpers/projectScope.ts", "tests/projectChangeVerifier.test.ts", "tests/m2Orchestration.test.ts", "tests/m2Acceptance.test.ts", "tests/m3T1AdapterBoundary.test.ts", "tests/m3T2PnpmPreflight.test.ts", "tests/m3T3BoundedVerification.test.ts", "tests/m3T4CrossProjectAcceptance.test.ts", "tests/evidenceV2.test.ts", "tests/m4T1TaskContract.test.ts", "tests/m4T2Preflight.test.ts", "tests/m4CompleteTargetSet.test.ts", "tests/m4T3WriteCoordinator.test.ts", "tests/m4T4OrderedEvidence.test.ts", "tests/m4T4ProjectChangeVerifier.test.ts", "tests/helpers/cliArtifact.ts", "vitest.config.ts", "eslint.config.js"],
  "exclude": ["node_modules", "dist", "fixtures", ".sureflow"]
}
